<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#167ED6"
                android:centerColor="#4FB3EC"
                android:endColor="#A6E2FA" />
        </shape>
    </item>

    <!-- Intentional inset keeps the supplied-style weather artwork fully visible on launchers. -->
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"
        android:drawable="@drawable/ic_launcher_weather_foreground" />
</layer-list>
